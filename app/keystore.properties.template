# app/keystore.properties
# Copy this file to app/keystore.properties and fill in your real values.
# DO NOT commit the filled-in version — it is in .gitignore.

# Path to your .jks file, relative to the app/ directory
storeFile=../release.jks

# Passwords and alias set when you created the keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
